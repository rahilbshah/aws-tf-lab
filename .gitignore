# Terraform plugin cache and module cache (regenerated by `terraform init`)
**/.terraform/*

# State files — contain real-world resource mappings AND can hold plaintext secrets
*.tfstate
*.tfstate.*

# Crash logs from panics in the Terraform CLI itself
crash.log
crash.*.log

# Variable values — often hold environment-specific data and secrets
*.tfvars
*.tfvars.json

# Override files — local-only experiments that Terraform auto-merges on top of main config
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration — machine-specific, may contain tokens
.terraformrc
terraform.rc

# Provider dependency lock file
# NOTE: in real/team projects this SHOULD be committed for reproducible provider versions.
# Ignoring while solo-learning is fine; flip this rule when collaborating.
.terraform.lock.hcl

# Claude Code local tool state (agent state, plans, settings) — machine-specific
.claude/

# Saved plan files (binary) — workspace artifacts, regeneratable with `terraform plan -out=...`
*.tfplan

# macOS Finder metadata
.DS_Store

# Obsidian per-session/per-device state (churns constantly; not shareable)
notes/.obsidian/workspace.json
notes/.obsidian/workspace-mobile.json
notes/.obsidian/cache
