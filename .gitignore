# Terraform plugin cache and module cache (regenerated by `terraform init`)
**/.terraform/*

# State files — contain real-world resource mappings AND can hold plaintext secrets
*.tfstate
*.tfstate.*

# Crash logs from panics in the Terraform CLI itself
crash.log
crash.*.log

# Variable values — often hold environment-specific data and secrets
*.tfvars
*.tfvars.json

# Override files — local-only experiments that Terraform auto-merges on top of main config
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration — machine-specific, may contain tokens
.terraformrc
terraform.rc

# Provider dependency lock file
# NOTE: in real/team projects this SHOULD be committed for reproducible provider versions.
# Ignoring while solo-learning is fine; flip this rule when collaborating.
.terraform.lock.hcl

# Claude Code local tool state (agent state, plans, settings) — machine-specific
.claude/

# Saved plan files (binary) — workspace artifacts, regeneratable with `terraform plan -out=...`
*.tfplan

# macOS Finder metadata
.DS_Store

# Obsidian per-session/per-device state (churns constantly; not shareable)
# Vault root was renamed notes/ -> aws-tf-lab/
# Obsidian is a personal environment, not vault content. Track only the CSS
# we actually author; plugins and themes are downloadable (1.35 MB of vendored
# plugin code was in here), and the settings JSONs churn on every tweak.
aws-tf-lab/.obsidian/*
!aws-tf-lab/.obsidian/snippets/
aws-tf-lab/.obsidian/snippets/*.css.bak

# Human-readable plan dumps (terraform show > plan.txt) — workspace artifacts
plan.txt

# Python bytecode from the vault generators
__pycache__/
*.pyc


# Downloaded source PDFs - notes cite the live docs URL, not the local copy
*.pdf

# Obsidian's local trash (trashOption: "local") — churn, never content
aws-tf-lab/.trash/
